# Discord bot token (https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=
# Your server id (right-click server -> Copy Server ID). Makes slash commands appear instantly.
GUILD_ID=
# Role ids allowed to add/remove songs (comma separated). Members with Manage Server always can.
EDITOR_ROLE_IDS=

# github = commit songs to your repo (recommended)  |  local = write into ../library
STORAGE=github
# Fine-grained token with "Contents: Read and write" on the repo below
GITHUB_TOKEN=
GITHUB_REPO=trocktristan-hash/piano-hub
GITHUB_BRANCH=main
LIBRARY_PATH=library

MAX_MIDI_KB=1024
MAX_SONG_SECONDS=900
